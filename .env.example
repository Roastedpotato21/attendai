# Browser-safe Supabase connection values. Copy to .env for local development.
VITE_DATA_MODE=supabase
# Optional public policy contact text. Until configured, the pages direct requests to the institution administrator.
VITE_POLICY_CONTACT=
ATTENDANCE_PUSH_TTL_SECONDS=21600
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-key>

# Supabase CLI values. Do not expose these with a VITE_ prefix or commit .env.
SUPABASE_ACCESS_TOKEN=<supabase-personal-access-token>
SUPABASE_PROJECT_REF=<project-ref>

# Server-only communication worker and provider configuration. Never use VITE_ prefixes.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
# Public application origin for authenticated invitations and policy links.
ATTENDAI_APP_URL=https://<deployment-host>
COMMUNICATION_WORKER_SECRET=<long-random-worker-secret>
COMMUNICATION_WORKER_BATCH_SIZE=20
# SMS is disabled unless explicitly set to simulate or live on the server.
SMS_DELIVERY_MODE=disabled
SMS_PROVIDER=fast2sms
# Only named one-attempt jobs can run while the controlled trial is gated.
SMS_CONTROLLED_ONLY=true
# Cloudflare Worker secret storage only; never expose through VITE_*.
FAST2SMS_API_KEY=<server-only-fast2sms-key>
# Legacy informational setting; SMS and FCM workers now run independently.
NOTIFICATION_PROVIDER=sms
# Keep disabled until one controlled test is explicitly authorized.
FCM_DELIVERY_MODE=disabled
FIREBASE_PROJECT_ID=attendai-41f64
# Server credential: prefer deployment ADC. A server secret named
# FIREBASE_SERVICE_ACCOUNT_JSON is also supported; never add it to VITE_* or git.

# Public Firebase Web app values. These are safe for the browser.
VITE_FIREBASE_API_KEY=AIzaSyB4LgLq152HzZ11_m6mhR4KV7ul04I4YEE
VITE_FIREBASE_AUTH_DOMAIN=attendai-41f64.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=attendai-41f64.firebasestorage.app
VITE_FIREBASE_PROJECT_ID=attendai-41f64
VITE_FIREBASE_MESSAGING_SENDER_ID=849652695985
VITE_FIREBASE_APP_ID=1:849652695985:web:8b73aa6ecf97a2f313f390
VITE_FIREBASE_MEASUREMENT_ID=G-YYVLV96BFV
# Set to the Web Push public key from Firebase Console > Project settings > Cloud Messaging.
VITE_FIREBASE_VAPID_KEY=
# Required for live mode. Comma-separated, explicitly approved E.164 recipients.
SMS_LIVE_RECIPIENT_ALLOWLIST=
# Legacy Twilio configuration retained for historical callbacks/WhatsApp.
# These settings cannot enable new Twilio SMS. Fast2SMS uses Quick SMS route q.
SMS_INDIA_DLT_READY=false
# Current Twilio product trial supports verified US SMS recipients only.
# Trial SMS API uses the fixed Twilio Body identifier sms_appointment_reminders;
# this does not contain the student's actual attendance details.
# The retired Twilio SMS path is disabled regardless of these settings.
TWILIO_TRIAL_MODE=false
TWILIO_ACCOUNT_SID=<twilio-account-sid>
TWILIO_AUTH_TOKEN=<twilio-auth-token>
TWILIO_PHONE_NUMBER=<e164-sms-sender>
TWILIO_WHATSAPP_FROM=<e164-whatsapp-sender>
TWILIO_WEBHOOK_PUBLIC_URL=https://<deployment-host>/api/webhooks/twilio/status
TWILIO_WHATSAPP_CONTENT_SID_EN=<approved-content-sid>
TWILIO_WHATSAPP_CONTENT_SID_HI=<approved-content-sid>
TWILIO_WHATSAPP_CONTENT_SID_TE=<approved-content-sid>
TWILIO_WHATSAPP_CONTENT_SID_TA=<approved-content-sid>
TWILIO_WHATSAPP_CONTENT_SID_KN=<approved-content-sid>
